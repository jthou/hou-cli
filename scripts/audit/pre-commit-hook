#!/bin/bash
# 开发审计 pre-commit hook：当 API 或前端代码变更时，自动运行审计并更新报告
set -e
PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$PROJECT_ROOT"

# 检查是否有 API 或前端相关变更
STAGED=$(git diff --cached --name-only)
RUN_AUDIT=0
if echo "$STAGED" | grep -qE '^backend/api/|^frontend/react-app/src/'; then
  RUN_AUDIT=1
fi

if [ "$RUN_AUDIT" = "1" ]; then
  echo "[audit] 检测到 API/前端变更，运行开发审计..."
  if [ -f venv/bin/activate ]; then
    source venv/bin/activate
  fi
  python scripts/run_audit.py || true
  # 将生成的报告加入本次提交（若存在）
  for f in docs/audit/AUDIT_REPORT.json docs/audit/code_stats.json docs/audit/dev_history.json docs/audit/API_PATH_AUDIT.md; do
    [ -f "$f" ] && git add "$f" 2>/dev/null || true
  done
fi
exit 0

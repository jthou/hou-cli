{
  "manifest_version": 3,
  "name": "Hou CLI 网页阅读助手",
  "version": "1.0.0",
  "description": "配合 Hou CLI 网页阅读、PDF 阅读、视频下载等功能，复用浏览器登录态",
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*",
        "http://localhost:8081/*",
        "http://127.0.0.1:8081/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5174/*",
        "http://127.0.0.1:5174/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:5000/*",
        "http://127.0.0.1:5000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
